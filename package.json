{
    "name": "todolist-app",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "// --- BUILDING ---": "",
        "build": "pnpm run build:prebuild && tsc && vite build && pnpm run fix && pnpm run build:postbuild",
        "build:prebuild": "pnpm run fix && pnpm run check && pnpm run test",
        "build:postbuild": "pnpm run fix",
        "dev": "vite",
        "preview": "vite preview",
        "// --- CHECKING & FORMATTING & LINTING ---": "",
        "check": "pnpm run typecheck && pnpm run format:check && pnpm run lint:check",
        "fix": "pnpm run format:fix && pnpm run lint:fix",
        "format": "pnpm run format:fix",
        "format:check": "oxfmt --check",
        "format:fix": "oxfmt",
        "lint": "pnpm run lint:fix",
        "lint:check": "oxlint",
        "lint:fix": "oxlint --fix",
        "typecheck": "tsc --noEmit",
        "// --- TESTING ---": "",
        "coverage": "vitest run --coverage",
        "test": "vitest run",
        "test:e2e": "pnpm exec playwright test",
        "test:e2e:ui": "pnpm exec playwright test --ui",
        "test:watch": "vitest",
        "// --- CI ---": "",
        "ci:check": "pnpm run check",
        "ci:test:unit": "pnpm run coverage",
        "ci:test:e2e": "pnpm run test:e2e"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/ms": "^2.1.0",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.4",
        "jsdom": "^29.0.2",
        "oxfmt": "^0.45.0",
        "oxlint": "^1.60.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    },
    "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
    "dependencies": {
        "@reduxjs/toolkit": "^2.11.2",
        "@tailwindcss/vite": "^4.2.2",
        "clsx": "^2.1.1",
        "ms": "^2.1.3",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-redux": "^9.2.0",
        "tailwindcss": "^4.2.2",
        "zod": "^4.3.6"
    }
}
